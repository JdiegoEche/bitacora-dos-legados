    "@hono/zod-validator": "^0.4.0",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.0",
    "drizzle-zod": "^0.6.0",
    "hono": "^4.6.0",
    "jose": "^6.2.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
